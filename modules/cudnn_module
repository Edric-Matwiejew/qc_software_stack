-- -*- lua -*-
help([[
NVIDIA cuDNN CUDNNVERSION: GPU-accelerated primitives for deep neural networks.
]])

whatis("Name: cuDNN CUDNNVERSION")
whatis("CUDA Version: CUDAVERSION")
whatis("Documentation: https://docs.nvidia.com/deeplearning/cudnn/")

if (not isloaded("nvhpc/NVHPCVERSION")) then
    load("nvhpc/NVHPCVERSION")
end
depends_on("nvhpc/NVHPCVERSION")

local CUDNN_ROOT = "CUDNNROOT"

setenv("CUDNN_ROOT",        CUDNN_ROOT)
setenv("CUDNN_INCLUDE_DIR", pathJoin(CUDNN_ROOT, "include"))
setenv("CUDNN_LIB_DIR",     pathJoin(CUDNN_ROOT, "lib"))
prepend_path("LIBRARY_PATH",      pathJoin(CUDNN_ROOT, "lib"))
prepend_path("LD_LIBRARY_PATH",   pathJoin(CUDNN_ROOT, "lib"))
prepend_path("CPATH",             pathJoin(CUDNN_ROOT, "include"))
prepend_path("CMAKE_PREFIX_PATH", CUDNN_ROOT)
